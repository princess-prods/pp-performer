# Environment variables for pp-performer
# Copy this file to .env and fill in your values

# Supabase configuration (frontend - safe to expose)
NG_APP_SUPABASE_URL="https://your-project.supabase.co"
NG_APP_SUPABASE_ANON_KEY="your-anon-key"

# Database (backend only - not exposed to frontend)
DATABASE_URL="postgresql://user:password@host/database"
DATABASE_URL_POOLED="postgresql://user:password@host/database"

# Supabase secrets (backend only)
SUPABASE_DB_PASSWORD="your-db-password"

# Google OAuth (backend only - configured in Supabase dashboard)
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Yoti IDV - Age verification (backend only)
YOTI_CLIENT_SDK_ID="your-yoti-client-sdk-id"
# Local: path to PEM file (store in keys/ directory, which is gitignored)
YOTI_PEM_KEY_PATH="./keys/yoti.pem"
# CI/Netlify: base64-encoded PEM content (use instead of file path)
# Generate with: base64 -w 0 ./keys/yoti.pem
# YOTI_PEM_KEY_BASE64="base64-encoded-pem-content"
